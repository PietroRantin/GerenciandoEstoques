# Copie este arquivo para .env e ajuste os valores.
# Chave usada para assinar a sessão. Em produção, use um valor longo e aleatório.
SECRET_KEY=troque-esta-chave-em-producao
# Banco de dados. Padrão: SQLite em instance/estoque.db
# Exemplo PostgreSQL: postgresql+psycopg2://usuario:senha@localhost:5432/estoque
DATABASE_URL=
# Porta do servidor de desenvolvimento
PORT=5000
